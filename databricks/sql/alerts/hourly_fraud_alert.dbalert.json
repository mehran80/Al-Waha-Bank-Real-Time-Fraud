{
  "evaluation": {
    "source": {
      "name": "fraud_count",
      "display": "fraud_count",
      "aggregation": "AGGREGATION_UNSPECIFIED"
    },
    "comparison_operator": "GREATER_THAN",
    "threshold": {
      "value": {
        "double_value": 50.0
      }
    },
    "notification": {
      "notify_on_ok": true
    }
  },
  "schedule": {
    "quartz_cron_schedule": "16 0 20 * * ?",
    "timezone_id": "Asia/Karachi"
  },
  "query_lines": [
    "SELECT COUNT(*) AS fraud_count",
    "FROM alwaha_banking_dev_001.gold.gold_fraud_alerts",
    "WHERE alert_timestamp > current_timestamp() - INTERVAL 1 HOUR;"
  ]
}
